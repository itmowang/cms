{$SITE_ADDRESS::80} {
	encode zstd gzip

	# 多个域名时统一跳转到主域名（PRIMARY_HOST 取自 NEXT_PUBLIC_SITE_URL，未绑定域名时为空、不跳转）
	@alias expression `"{$PRIMARY_HOST}" != "" && {host} != "{$PRIMARY_HOST}"`
	redir @alias https://{$PRIMARY_HOST}{uri} 308

	# 上传的图片：Caddy 直接读文件返回，不经过 Node；文件名是内容哈希，可永久缓存
	handle /uploads/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		header X-Content-Type-Options nosniff
		file_server
	}

	handle {
		reverse_proxy app:3000
	}
}
