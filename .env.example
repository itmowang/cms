# 站点对外访问地址（用于 canonical、sitemap、JSON-LD，务必改成正式域名）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 后台账号（生产环境必须设置，否则禁止登录）
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
# 会话签名密钥，至少 32 位随机字符串
AUTH_SECRET=please-replace-with-a-long-random-string-0123456789

# 可选：百度普通收录 API 推送地址（站长平台 -> 普通收录 -> API 提交 中获取）
# BAIDU_PUSH_API=http://data.zz.baidu.com/urls?site=https://www.example.com&token=xxxx
# 可选：IndexNow key（Bing / Yandex 等即时收录）
# INDEXNOW_KEY=

# MCP 接口（POST /api/mcp，Authorization: Bearer <token>），至少 24 位随机字符串，都不配置则 MCP 关闭
# 生成：node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# 管理员（读写：文章、频道、站点设置、推送收录）
MCP_TOKEN=
# 只读（只能读取已公开内容，适合给 AI 助手 / 合作方）
MCP_READONLY_TOKEN=
